{
  "name": "lol-review",
  "version": "0.1.0",
  "private": true,
  "description": "国服海克斯大乱斗本地战报工具",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:lcu": "tsx src/tools/verify-lcu.ts",
    "verify:data": "tsx src/tools/verify-data.ts",
    "gen:types": "tsx src/tools/gen-types.ts",
    "dev": "concurrently -k -n vite,electron -c gray,cyan \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:electron": "npm run dev",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.0",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@visx/xychart": "4.0.0",
    "better-sqlite3": "13.0.3",
    "dayjs": "1.11.23",
    "electron-log": "5.4.4",
    "electron-trpc": "0.7.1",
    "electron-window-state": "5.0.3",
    "gsap": "3.15.0",
    "league-connect": "6.0.0-rc13",
    "lucide-react": "1.61.0",
    "morphicons": "2.0.2",
    "nanoid": "6.0.2",
    "p-limit": "7.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.32.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "3.2.4",
    "wait-on": "9.5.1"
  }
}
